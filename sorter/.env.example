# Copy this file to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=

# Set to 1 to run the whole pipeline with synthetic sensor/camera/servo data
# (no GPIO, serial, or camera device is touched). Set to 0 (or unset) on the
# real Raspberry Pi with hardware attached.
MOCK_HARDWARE=1

# Servo bus. Default is the Pi 5 header UART (GPIO14 TX / GPIO15 RX) wired
# directly to the servo data line. Use /dev/ttyACM0 for a USB bus adapter.
# SERVO_PORT=/dev/ttyAMA0

# Servo IDs. Set both to the same ID for the single-servo build.
# SERVO_ID_SAFE_GATE=1
# SERVO_ID_FLAGGED_GATE=2
